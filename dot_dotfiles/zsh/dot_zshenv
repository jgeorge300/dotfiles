# Lightweight environment shared by login shells, child shells, and scripts.
# Keep command execution, directory creation, and tool setup in .zprofile.
source "$ZDOTDIR/common.zsh"

export DOCKER_SCAN_SUGGEST=false
export TMUX_PLUGIN_MANAGER_PATH="$XDG_DATA_HOME/tmux/tmux-plugins"
export COREPACK_ENABLE_AUTO_PIN=0
export RIPGREP_CONFIG_PATH="$XDG_CONFIG_HOME/ripgrep"

# Include the default config, then YAML files in alphabetical order.
typeset -a kubeconfig_files
kubeconfig_files=(
  "$HOME/.kube/config"(N.)
  "$HOME"/.kube/*.yaml(N.)
  "$HOME"/.kube/*.yml(N.)
)

if (( ${#kubeconfig_files} )); then
  export KUBECONFIG="${(j.:.)kubeconfig_files}"
else
  unset KUBECONFIG
fi

unset kubeconfig_files
